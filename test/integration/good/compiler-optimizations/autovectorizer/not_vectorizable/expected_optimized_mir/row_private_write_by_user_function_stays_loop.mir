/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../row_private_write_by_user_function_stays_loop.stan : [exit 0] */
functions {
  real shift(real x) {
    {
      FnPrint__("shift ", x);
      return (x + promote(1, real, data));
    }
  } }
input_vars {
  int N;
  vector[N] x;
  vector[N] y; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x");
  FnValidateSize__("y", "N", N);
  data vector[N] y;
  FnReadData__(y, context__, "y"); }

log_prob {
  real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("mu", "N", N);
    vector[N] mu;
    for(n in 1:N) {
      mu[n] = shift(x[n]);
      target += normal_lpdf(y[n], mu[n], sigma);
    }
  } }

rev_log_prob {
  real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("mu", "N", N);
    vector[N] mu;
    for(n in 1:N) {
      mu[n] = shift(x[n]);
      target += normal_lpdf(y[n], mu[n], sigma);
    }
  } }

generate_quantities {
  data real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var sigma))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real sigma;
  FnReadData__(sigma, context__, "sigma");
  (FnWriteParam(unconstrain_opt((Lower 0)))(var sigma))__(); }
output_vars {
  parameters real sigma; //real
}
